      "Name": "Mute",
      "UUID": "com.davidhifi.yapfast.mute",
      "Icon": "imgs/actions/mute",
      "Tooltip": "Mute or unmute your microphone",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "UserTitleEnabled": false,
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/keys/mute-0",

#!/usr/bin/env bash
# Draws packaging/windows/yapfast.ico (the Mocha blue to mauve icon of
# packaging/icon.svg) at each size Windows asks for, from 16 px in the title
# bar to 256 px in Explorer. Needs python3 with Pillow. An optional folder
# argument also gets each size as a PNG.
set -euo pipefail
exec python3 "$(dirname "${BASH_SOURCE[0]}")/make_windows_icon.py" "$@"
